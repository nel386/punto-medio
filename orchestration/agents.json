    {"id":"content-01","owns":["content/categories/deporte.json","content/categories/ocio.json","content/categories/fiesta.json"],"dependsOn":["product"],"deliverable":"30 escalas"},
    {"id":"content-02","owns":["content/categories/comida-bebida.json","content/categories/viajes.json","content/categories/television-cine.json"],"dependsOn":["product"],"deliverable":"30 escalas"},
    {"id":"content-03","owns":["content/categories/cultura.json","content/categories/amistad.json","content/categories/relaciones.json"],"dependsOn":["product"],"deliverable":"30 escalas"},
    {"id":"content-04","owns":["content/categories/personalidad.json","content/categories/tecnologia.json","content/categories/trabajo-estudios.json"],"dependsOn":["product"],"deliverable":"30 escalas"},
